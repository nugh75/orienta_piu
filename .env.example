# =============================================================================
# ORIENTA+ - Configurazione Ambiente
# =============================================================================
# Copia questo file in .env e inserisci le tue chiavi API
# cp .env.example .env
#
# IMPORTANTE: Non committare mai il file .env con le chiavi reali!
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys per LLM (almeno una richiesta per revisione AI)
# -----------------------------------------------------------------------------

# OpenAI API Key (opzionale)
# Usata per: embedding, analisi avanzate
# Ottieni da: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter API Key (consigliata)
# Usata per: revisione report, revisione scores
# Ottieni da: https://openrouter.ai/keys
# Nota: molti modelli gratuiti disponibili (es. meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_API_KEY=

# Google Gemini API Key (consigliata)
# Usata per: revisione report, sintesi best practice
# Ottieni da: https://aistudio.google.com/apikey
# Nota: quota gratuita generosa
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Ollama (opzionale - per esecuzione locale o remota)
# -----------------------------------------------------------------------------

# URL del server Ollama
# Default: http://localhost:11434
# Per server remoto: http://192.168.129.14:11434
OLLAMA_HOST=http://localhost:11434

# Modello Ollama preferito (default: qwen3:latest)
OLLAMA_MODEL=qwen3:latest

# -----------------------------------------------------------------------------
# Configurazione Dashboard (opzionale)
# -----------------------------------------------------------------------------

# Porta Streamlit (default: 8501)
# STREAMLIT_PORT=8501

# Porta portale upload PTOF (default: 8502)
# UPLOAD_PORTAL_PORT=8502

# -----------------------------------------------------------------------------
# API di Ricerca PTOF Avanzata (opzionali - per trovare PTOF difficili)
# -----------------------------------------------------------------------------

# Jina AI - Gratuito (rate limited)
# Non richiede API key per uso base
# Documentazione: https://jina.ai/reader

# Tavily AI - 1000 crediti/mese GRATIS
# Ottieni da: https://app.tavily.com/home
TAVILY_API_KEY=

# Brave Search - 2000 query/mese GRATIS
# Ottieni da: https://brave.com/search/api/
BRAVE_API_KEY=

# Perplexity AI - Per ricerche difficili (finale)
# Ottieni da: https://www.perplexity.ai/settings/api
# Nota: richiede abbonamento Pro o crediti API
PERPLEXITY_API_KEY=
