<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PTOF Task Runner</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <script>
        // Base URL per API e SSE (gestisce proxy)
        // Rileva automaticamente se siamo sotto /taskrunner/
        (function() {
            var path = window.location.pathname;
            if (path.startsWith('/taskrunner')) {
                window.TASKRUNNER_BASE = '/taskrunner';
            } else {
                window.TASKRUNNER_BASE = '';
            }
        })();
    </script>
</head>
<body>
    <header>
        <h1>PTOF Task Runner</h1>
        <div id="status-indicator">
            <span id="connection-status" class="disconnected">Disconnesso</span>
            <span id="active-count">0 task attivi</span>
        </div>
    </header>

    <main>
        <aside id="sidebar">
            <section id="commands-section">
                <h2>Comandi</h2>
                <div id="command-list"></div>
            </section>

            <section id="tasks-section">
                <h2>Task Recenti</h2>
                <div id="task-list"></div>
                <button id="btn-clear-finished" class="btn-secondary">Pulisci completati</button>
            </section>
        </aside>

        <section id="main-content">
            <div id="command-form" class="hidden">
                <h3 id="command-title"></h3>
                <p id="command-description"></p>
                <form id="params-form"></form>
                <div class="button-group">
                    <button id="btn-start" class="btn-primary">Avvia</button>
                    <button id="btn-cancel" class="btn-secondary">Annulla</button>
                </div>
            </div>

            <div id="output-section">
                <div id="output-header">
                    <h3>Output <span id="current-task-id"></span></h3>
                    <div class="button-group">
                        <button id="btn-stop" class="btn-warning" disabled>Stop</button>
                        <button id="btn-kill" class="btn-danger" disabled>Kill</button>
                        <button id="btn-clear" class="btn-secondary">Pulisci</button>
                    </div>
                </div>
                <pre id="output-container"></pre>
            </div>
        </section>
    </main>

    <footer>
        <p>PTOF Task Runner - <a href="/">Dashboard</a></p>
    </footer>

    <script src="{{ url_for('static', filename='js/taskrunner.js') }}"></script>
</body>
</html>
